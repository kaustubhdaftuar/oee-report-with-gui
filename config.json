{
    "es_url": "******************************************",
    "api_key": "************************************",
    "fields": [
        "@timestamp",
        "sensorid",
        "value",
        "sensoridPrevEvent",
        "durationPrevEvent",
        "scaledDurationPrevEvent"
    ],
    "sites": [
        {
            "site_id": "jk_cement_aligarh",
            "name": "JK Cement",
            "location": "Aligarh",
            "es_index": "iotgateway-jkcement-aligarh-*",
            "template_path": "templates/jk_cement_aligarh/template.docx",
            "output_folder": "output/jk_cement_aligarh",
            "excel_path": "working_data/jk_cement_aligarh",
            "excel_filename": "jk_cement_aligarh_week_{week}.xlsx",
            "shifts": [
                {
                    "shift_id": "A",
                    "name": "Shift A",
                    "start_hour": 6,
                    "end_hour": 14
                },
                {
                    "shift_id": "B",
                    "name": "Shift B",
                    "start_hour": 14,
                    "end_hour": 22
                },
                {
                    "shift_id": "C",
                    "name": "Shift C",
                    "start_hour": 22,
                    "end_hour": 30
                }
            ],
            "production_day_start_hour": 6,
            "timezone": "Asia/Kolkata",
            "plc_config": [
                {
                    "plc_id": "PLC_01",
                    "name": "Fillpac 1 Part 1",
                    "spouts": 16,
                    "description": "Packer 1"
                },
                {
                    "plc_id": "PLC_02",
                    "name": "Fillpac 1 Part 2",
                    "spouts": 16,
                    "description": "Packer 2"
                }
            ],
            "sensor_keywords": {
                "availability": {
                    "fault_counter": {
                        "description": "Fault duration tracking",
                        "sensoridPrevEvent_keyword": "Fault_Counter",
                        "field": "durationPrevEvent",
                        "aggregation": "sum"
                    },
                    "ideal_fault": {
                        "description": "Ideal fault open (Belt Not Running)",
                        "sensoridPrevEvent_keyword": "IdealFaultopen",
                        "field": "durationPrevEvent",
                        "aggregation": "sum"
                    }
                },
                "downtime_by_plc": {
                    "plc_01": {
                        "name": "PLC_01 Downtime",
                        "parentid_filter": "PLC_01",
                        "faults": {
                            "spout_fault": {
                                "name": "Spout Fault",
                                "sensorid_keyword": "FAULT_OPEN_SP*",
                                "type": "wildcard"
                            },
                            "main_drive_stop": {
                                "name": "Main Drive Stop",
                                "sensorid_keyword": "FillPackMainDrivestop",
                                "type": "term"
                            },
                            "belt_not_running": {
                                "name": "Belt Not Running",
                                "sensorid_keyword": "IdealFaultopen",
                                "type": "term"
                            }
                        }
                    },
                    "plc_02": {
                        "name": "PLC_02 Downtime",
                        "parentid_filter": "PLC_02",
                        "faults": {
                            "spout_fault": {
                                "name": "Spout Fault",
                                "sensorid_keyword": "FAULT_OPEN_P02_SP*",
                                "type": "wildcard"
                            },
                            "main_drive_stop": {
                                "name": "Main Drive Stop",
                                "sensorid_keyword": "FillPackMainDrivestop",
                                "type": "term"
                            },
                            "belt_not_running": {
                                "name": "Belt Not Running",
                                "sensorid_keyword": "IdealFaultopen",
                                "type": "term"
                            }
                        }
                    }
                },
                "quality": {
                    "good_bags": {
                        "name": "Good Bags",
                        "sensorid_keywords": ["Bag_Discharge_SP*", "Packer02_Bag_Discharge_SP*"],
                        "field": "value",
                        "aggregation": "sum",
                        "type": "wildcard",
                        "description": "Total bags discharged successfully"
                    },
                    "burst_bags": {
                        "name": "Burst Bags",
                        "sensorid_keywords": ["DownTime_BagBurstFault_SP*", "DownTime_BagBurstFault_P02_SP*"],
                        "field": "value",
                        "aggregation": "sum",
                        "type": "wildcard",
                        "description": "Bags that burst during production"
                    },
                    "out_of_limit_bags": {
                        "name": "Out of Limit Bags",
                        "sensorid_keywords": ["DownTime_Bag_OutOfLimit_SP*", "DownTime_Bag_OutOfLimit_P02_SP*"],
                        "field": "value",
                        "aggregation": "sum",
                        "type": "wildcard",
                        "description": "Bags outside weight/dimension limits"
                    }
                },
                "spout_faults": {
                    "plc_01": {
                        "pattern": "FAULT_OPEN_SP*",
                        "description": "PLC_01 Spout Faults - extract spout numbers from sensor name",
                        "spout_extraction_regex": "SP(\\d+)$"
                    },
                    "plc_02": {
                        "pattern": "FAULT_OPEN_P02_SP*",
                        "description": "PLC_02 Spout Faults - extract spout numbers from sensor name",
                        "spout_extraction_regex": "SP(\\d+)$"
                    }
                }
            },
            "excel_cell_mapping": {
                "oee": "C3",
                "availability": "C4",
                "performance": "C5",
                "quality": "C6",
                "planned_production_time": "C8",
                "total_available_time": "C9",
                "spout_fault": "C10",
                "main_drive_stop": "C11",
                "belt_not_running": "C12",
                "actual_good_bags": "C14",
                "expected_good_bags": "C15",
                "good_bags": "C17",
                "burst_bags": "C18",
                "out_of_limit_bags": "C19",
                "total_bags": "C20",
                "shift_a_changeover": "C22",
                "shift_b_changeover": "C23",
                "shift_c_changeover": "C24",
                "start_date": "E3",
                "end_date": "E4"
            },
            "week_lookup_offset": 1,
            "kpi_thresholds": {
                "availability_min": 85,
                "performance_min": 90,
                "quality_min": 95,
                "oee_min": 70
            },
            "formulas": {
                "downtime_divisor": 608.33,
                "availability": "(planned_time - fault_time) / planned_time * 100",
                "performance": "actual_production / expected_production * 100",
                "quality": "good_bags / actual_good_bags * 100",
                "oee": "(availability * performance * quality) / 10000"
            },
            "es_aggregation": {
                "parentid_field": "parentid.keyword",
                "sensorid_field": "sensorid.keyword",
                "sensoridPrevEvent_field": "sensoridPrevEvent.keyword",
                "time_field": "@timestamp",
                "duration_field": "durationPrevEvent",
                "value_field": "value",
                "runtime_field": "scaledDurationPrevEvent",
                "request_timeout": "120s"
            }
        },
